<Page
 x:Class="XboxDownloader.MainPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Padding="40">
  <StackPanel Spacing="18" MaxWidth="1100">
   <TextBlock Text="Xbox Downloader" FontSize="42"/>
   <TextBlock Text="Cole a URL direta do arquivo e toque em Baixar." FontSize="20"/>
   <TextBox x:Name="UrlBox" Header="URL do arquivo" PlaceholderText="https://exemplo.com/arquivo.zip" FontSize="20"/>
   <Button Content="BAIXAR" Click="Download_Click" FontSize="22" HorizontalAlignment="Left" Padding="28,12"/>
   <ProgressBar x:Name="Progress" Height="18" Minimum="0" Maximum="100"/>
   <TextBlock x:Name="Status" Text="Pronto." TextWrapping="Wrap" FontSize="18"/>
  </StackPanel>
 </Grid>
</Page>
